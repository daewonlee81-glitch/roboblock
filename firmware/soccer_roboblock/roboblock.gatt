PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "RoboBlock"

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// RoboBlock 서비스
PRIMARY_SERVICE, 7B1C0000-5A3E-4C2B-9F6D-2B7E0D1A0C00
// 명령 (에디터 → 로봇)
CHARACTERISTIC, 7B1C0001-5A3E-4C2B-9F6D-2B7E0D1A0C00, WRITE | WRITE_WITHOUT_RESPONSE | DYNAMIC
// 상태 (로봇 → 에디터, 10 Hz 알림)
CHARACTERISTIC, 7B1C0002-5A3E-4C2B-9F6D-2B7E0D1A0C00, READ | NOTIFY | DYNAMIC
// 로봇 정보 (종류, 펌웨어, 핀)
CHARACTERISTIC, 7B1C0003-5A3E-4C2B-9F6D-2B7E0D1A0C00, READ | DYNAMIC
